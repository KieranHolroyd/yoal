{
	"name": "@yoal/helper",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Privileged runtime helper: renders systemd units and drives workloads over a root-only unix socket.",
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"check": "tsc -p . --noEmit",
		"test": "bun test",
		"build": "bun build --compile --minify --define YOAL_FAULT_INJECTION=false --outfile dist/yoal-helper src/main.ts",
		"build:faults": "bun build --compile --minify --define YOAL_FAULT_INJECTION=true --outfile dist/yoal-helper-faults src/main.ts"
	},
	"engines": {
		"bun": ">=1.4"
	}
}
